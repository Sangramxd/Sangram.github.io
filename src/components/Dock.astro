---
import { navItems } from "../data/nav";

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<nav class="dock" aria-label="Primary">
  <div class="dock-inner" id="dock-inner">
    {navItems.map((item) => (
      <a href={item.href} class:list={["dock-item", { "is-active": isActive(item.href) }]}>
        <span class="dock-icon" set:html={item.icon} />
        <span class="dock-label">{item.label}</span>
        <span class="dock-dot" aria-hidden="true"></span>
      </a>
    ))}
  </div>
</nav>

<style>
  .dock {
    position: fixed;
    left: 50%;
    bottom: 14px;
    transform: translateX(-50%);
    z-index: 50;
    max-width: calc(100vw - 1.5rem);
  }
  .dock-inner {
    display: flex;
    align-items: flex-end;
    gap: 0.35rem;
    padding: 0.5rem 0.6rem 0.4rem;
    border-radius: 16px;
    border: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--paper-raised) 75%, transparent);
    backdrop-filter: blur(14px);
    box-shadow: 0 14px 34px -14px var(--shadow);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .dock-inner::-webkit-scrollbar { display: none; }

  .dock-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
    padding-top: 1.6rem;
    will-change: transform;
  }
  .dock-icon {
    width: 38px;
    height: 38px;
    display: block;
    border-radius: 11px;
    overflow: hidden;
    box-shadow: 0 3px 8px -3px rgba(0, 0, 0, 0.4);
    transition: transform 0.12s ease-out;
    transform-origin: bottom center;
  }
  .dock-icon :global(svg) { display: block; width: 100%; height: 100%; }
  .dock-label {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-data);
    font-size: 0.65rem;
    letter-spacing: 0.03em;
    white-space: nowrap;
    color: var(--ink);
    background: var(--paper-raised);
    border: 1px solid var(--line-strong);
    padding: 0.2em 0.5em;
    border-radius: 5px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.1s ease;
  }
  .dock-item:hover .dock-label,
  .dock-item:focus-visible .dock-label { opacity: 1; }
  .dock-item:hover .dock-icon,
  .dock-item:focus-visible .dock-icon { transform: translateY(-6px) scale(1.14); }

  .dock-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    margin-top: 0.3rem;
    background: transparent;
  }
  .dock-item.is-active .dock-dot { background: var(--accent); }

  @media (max-width: 640px) {
    .dock-icon { width: 34px; height: 34px; }
    .dock-label { display: none; }
  }
</style>

<script is:inline>
  (function () {
    var dock = document.getElementById("dock-inner");
    if (!dock) return;
    var icons = Array.prototype.slice.call(dock.querySelectorAll(".dock-icon"));
    var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduceMotion) return;

    var MAX_SCALE = 1.5;
    var RADIUS = 90;
    var rafPending = false;

    function apply(mouseX) {
      rafPending = false;
      icons.forEach(function (icon) {
        var rect = icon.getBoundingClientRect();
        var center = rect.left + rect.width / 2;
        var dist = Math.abs(mouseX - center);
        var t = Math.max(0, 1 - dist / RADIUS);
        var scale = 1 + t * (MAX_SCALE - 1);
        var lift = t * 8;
        icon.style.transform = "translateY(-" + lift.toFixed(1) + "px) scale(" + scale.toFixed(3) + ")";
      });
    }

    dock.addEventListener("mousemove", function (e) {
      var x = e.clientX;
      if (!rafPending) {
        rafPending = true;
        requestAnimationFrame(function () { apply(x); });
      }
    });
    dock.addEventListener("mouseleave", function () {
      icons.forEach(function (icon) { icon.style.transform = ""; });
    });
  })();
</script>
