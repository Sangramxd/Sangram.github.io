---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="Blog" description="Notes on research, robotics, and machine learning from Sangram Kumar Sahoo.">
  <section class="section wrap">
    <p class="eyebrow">Blog</p>
    <h1>Notes</h1>
  </section>

  <section class="section wrap">
    {posts.length === 0 ? (
      <p class="empty-state">No posts yet — check back soon.</p>
    ) : (
      <div class="post-list">
        {posts.map((post) => (
          <a class="panel post-card" href={`/blog/${post.slug}/`}>
            <div class="meta-row"><span>{post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</span></div>
            <h2>{post.data.title}</h2>
            <p>{post.data.summary}</p>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .post-list { display: flex; flex-direction: column; gap: 1rem; }
  .post-card { display: block; text-decoration: none; color: inherit; }
  .post-card h2 { font-size: 1.1rem; }
</style>
