---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const allTags = Array.from(new Set(projects.flatMap((p) => p.data.tags))).sort();
---

<BaseLayout title="Projects" description="Projects by Sangram Kumar Sahoo across robotics, computer vision, LLM agents, and manufacturing.">
  <section class="section wrap">
    <p class="eyebrow">Projects</p>
    <h1>All projects</h1>
    <div class="filter-row" role="group" aria-label="Filter projects by tag">
      <button class="tag filter-tag is-current" data-tag="all">all</button>
      {allTags.map((t) => <button class="tag filter-tag" data-tag={t}>{t}</button>)}
    </div>
  </section>

  <section class="section wrap">
    <div class="grid-auto" id="project-grid">
      {projects.map((p) => (
        <article class="panel project-card" data-tags={p.data.tags.join(",")}>
          <div class="meta-row">
            <span>{p.data.date}</span>
            {p.data.org && <span>{p.data.org}</span>}
          </div>
          <h2>{p.data.title}</h2>
          <p>{p.data.summary}</p>
          <ul>
            {p.data.bullets.map((b: string) => <li>{b}</li>)}
          </ul>
          <div class="tag-row">
            {p.data.tags.map((t: string) => <span class="tag" data-tag={t}>{t}</span>)}
          </div>
        </article>
      ))}
    </div>
    <p id="empty-msg" class="empty-state" hidden>No projects match that tag.</p>
  </section>
</BaseLayout>

<style>
  .filter-row { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1.2rem; }
  .filter-tag { cursor: pointer; background: transparent; font: inherit; }
  .filter-tag.is-current { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }
  .project-card h2 { font-size: 1.1rem; }
</style>

<script is:inline>
  (function () {
    var buttons = document.querySelectorAll(".filter-tag");
    var cards = document.querySelectorAll(".project-card");
    var emptyMsg = document.getElementById("empty-msg");

    function applyFilter(tag) {
      var visible = 0;
      cards.forEach(function (card) {
        var tags = (card.getAttribute("data-tags") || "").split(",");
        var show = tag === "all" || tags.indexOf(tag) !== -1;
        card.hidden = !show;
        if (show) visible++;
      });
      emptyMsg.hidden = visible !== 0;
    }

    buttons.forEach(function (btn) {
      btn.addEventListener("click", function () {
        buttons.forEach(function (b) { b.classList.remove("is-current"); });
        btn.classList.add("is-current");
        applyFilter(btn.getAttribute("data-tag"));
      });
    });
  })();
</script>
