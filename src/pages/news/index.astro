---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const items = (await getCollection("news")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="News" description="Updates, talks, and milestones from Sangram Kumar Sahoo.">
  <section class="section wrap">
    <p class="eyebrow">News</p>
    <h1>Updates</h1>
  </section>

  <section class="section wrap">
    {items.length === 0 ? (
      <p class="empty-state">No updates yet — check back soon.</p>
    ) : (
      <div class="news-list">
        {items.map((item) => (
          <a class="panel news-card" href={`/news/${item.slug}/`}>
            <div class="meta-row"><span>{item.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</span></div>
            <h2>{item.data.title}</h2>
            <p>{item.data.summary}</p>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .news-list { display: flex; flex-direction: column; gap: 1rem; }
  .news-card { display: block; text-decoration: none; color: inherit; }
  .news-card h2 { font-size: 1.1rem; }
</style>
